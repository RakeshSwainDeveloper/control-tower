# ─────────────────────────────────────────────────────────────
# Control Tower — local environment
# Copy to .env and adjust. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug
TZ=Asia/Kolkata

# ── API ──────────────────────────────────────────────────────
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
# The e2e browser reaches the web app by its compose service name, so the
# Origin it sends is http://web:5173. Listing it keeps end-to-end running
# CROSS-ORIGIN, like a real deployment — which is where defect 15 lived.
CORS_ORIGINS=http://localhost:5173,http://web:5173

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=controltower
POSTGRES_USER=ct_app
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_in_env
# transaction-level pooling ONLY — session pooling leaks tenant context
DATABASE_URL=postgres://ct_app:change_me_in_env@postgres:5432/controltower
DATABASE_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Object storage (MinIO local / S3 prod) ───────────────────
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ct_minio_admin
S3_SECRET_KEY=change_me_in_env
S3_BUCKET_EVIDENCE=ct-evidence
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# ── Auth ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_generate_32_bytes_min
JWT_REFRESH_SECRET=change_me_generate_32_bytes_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# dev only: print OTP to logs instead of sending SMS
OTP_DEV_ECHO=true

# ── Email (Mailpit in dev) ───────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Control Tower <no-reply@controltower.local>"

# ── Evidence policy (FR-176, FR-177, FR-178) ─────────────────
EVIDENCE_MAX_PHOTO_BYTES=5242880
EVIDENCE_MAX_VIDEO_BYTES=15728640
EVIDENCE_MAX_VIDEO_SECONDS=30
EVIDENCE_GALLERY_MAX_AGE_HOURS=48

# ── Platform / Super Admin bootstrap ─────────────────────────
PLATFORM_BOOTSTRAP_EMAIL=platform@controltower.local
PLATFORM_BOOTSTRAP_PASSWORD=change_me_in_env
