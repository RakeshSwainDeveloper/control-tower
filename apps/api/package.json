{
  "name": "@ct/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --conditions=development --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "migrate:up": "node --conditions=development --import @swc-node/register/esm-register src/cli/migrate.ts up",
    "migrate:status": "node --conditions=development --import @swc-node/register/esm-register src/cli/migrate.ts status",
    "seed": "node --conditions=development --import @swc-node/register/esm-register src/cli/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ct/contracts": "workspace:*",
    "@ct/db": "workspace:*",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-fastify": "^10.4.8",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^9.0.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^5.9.6",
    "fastify": "4.29.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.8",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@swc/core": "^1.9.3",
    "@swc-node/register": "^1.10.9"
  }
}
