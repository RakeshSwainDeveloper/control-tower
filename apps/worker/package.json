{
  "name": "@ct/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --conditions=development --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/apps/worker/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ct/contracts": "workspace:*",
    "@ct/db": "workspace:*",
    "bullmq": "^5.28.1",
    "ioredis": "^5.4.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@swc/core": "^1.9.3",
    "@swc-node/register": "^1.10.9"
  }
}
