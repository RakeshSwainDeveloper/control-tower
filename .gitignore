node_modules/
# pnpm's content-addressed cache. `pnpm install` inside the e2e container
# writes 444 files here and only node_modules/ was ignored, so `git add e2e/`
# would have committed 13 MB of package cache.
.pnpm-store/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# secrets — never commit
.env
.env.*
!.env.example

# local volumes
.data/
pgdata/
miniodata/

# editor / os
.DS_Store
.idea/
*.swp

# test artefacts
playwright-report/
test-results/
